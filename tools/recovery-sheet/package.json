{
  "name": "sharekeeper-recovery-sheet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/finalize-build.mjs && vite build --config vite.site.config.js && node scripts/finalize-site.mjs",
    "dev:site": "vite --config vite.site.config.js --host 0.0.0.0 --port 3002",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "node --test tests/*.test.js site/*.test.js"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.3.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@vitejs/plugin-react": "^5.2.0",
    "lucide-react": "^1.70.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
